# Keep host dependencies and build artifacts out of the Linux image.
**/node_modules
**/.next
**/dist
**/build
**/coverage
**/*.tsbuildinfo

# Git state and local editor files are not needed in the image.
.git
.github
.vscode
.idea
.DS_Store

# Never bake credentials or proof bundles into the image.
**/.env
**/.env.*
output
**/*.log
