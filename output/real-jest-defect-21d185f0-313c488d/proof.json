        {
          "kind": "FILE",
          "source": "jest.setup.js",
          "observation": "Contains require('node:stream/web'), which attempts to load a Node.js core module in a Jest setup file."
        },
        {
          "kind": "FILE",
          "source": "jest.config.js",
          "observation": "Sets testEnvironment to 'jest-environment-jsdom', a browser-like environment that lacks full support for Node.js core modules such as node:stream/web."
        }
      ],
