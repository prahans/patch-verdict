# Optional server-only token, required only when a human creates a pull request.
# Copy to .env.local or configure this variable in the web server environment.
# Restrict the fine-grained token to the repositories you intend to publish to.
# Permissions: Contents read/write, Pull requests read/write, Issues read,
# and Metadata read. Never prefix this variable with NEXT_PUBLIC_.
PATCHVERDICT_GITHUB_TOKEN=
